<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="@dimen/padding_large"
    android:background="@color/backgroundDark">

    <TextView
        android:id="@+id/playerNameDetail"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Nome"
        android:textSize="@dimen/text_size_title"
        android:textColor="@color/colorPrimary"
        android:gravity="center"/>

    <TextView
        android:id="@+id/playerPosAgeDetail"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Posição | Idade"
        android:textColor="@color/textSecondary"
        android:gravity="center"
        android:layout_marginBottom="@dimen/padding_small"/>

    <TextView
        android:id="@+id/playerOverallDetail"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="OVR: 80"
        android:textColor="@color/colorPrimary"
        android:gravity="center"
        android:textSize="@dimen/text_size_subtitle"
        android:layout_marginBottom="@dimen/padding_medium"/>

    <TextView
        android:id="@+id/playerAttributesDetail"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Arremesso: 80\nDefesa: 80\nRebote: 80\nPasse: 80\nAtletismo: 80"
        android:textColor="@color/textPrimary"
        android:textSize="@dimen/text_size_body"
        android:layout_marginBottom="@dimen/padding_small"/>

    <TextView
        android:id="@+id/playerCareerDetail"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Carreira: 0 jogos, 0 pts, 0 reb, 0 ast"
        android:textColor="@color/textSecondary"
        android:textSize="@dimen/text_size_body"
        android:layout_marginBottom="@dimen/padding_small"/>

    <TextView
        android:id="@+id/playerStatusDetail"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Status: Disponível"
        android:textColor="@color/textSecondary"
        android:textSize="@dimen/text_size_body"/>
</LinearLayout>
