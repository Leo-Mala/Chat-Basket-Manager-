<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="@dimen/padding_medium"
    android:background="@color/backgroundDark">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="📋 Táticas"
        android:textSize="@dimen/text_size_title"
        android:textColor="@color/colorPrimary"
        android:gravity="center"
        android:layout_marginBottom="@dimen/padding_medium"/>

    <RadioGroup
        android:id="@+id/styleGroup"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:layout_marginBottom="@dimen/padding_medium">

        <RadioButton
            android:id="@+id/styleBalanced"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Equilibrado"
            android:textColor="@color/textPrimary"/>
        <RadioButton
            android:id="@+id/styleFastBreak"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Ataque Rápido"
            android:textColor="@color/textPrimary"/>
        <RadioButton
            android:id="@+id/styleHalfCourt"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Meia Quadra"
            android:textColor="@color/textPrimary"/>
        <RadioButton
            android:id="@+id/styleDefensive"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Defensivo"
            android:textColor="@color/textPrimary"/>
    </RadioGroup>

    <Button
        android:id="@+id/saveTacticsButton"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Salvar Táticas"
        android:backgroundTint="@color/colorPrimary"
        android:textColor="@color/textPrimary"/>
</LinearLayout>
